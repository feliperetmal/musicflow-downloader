# ============================================
# MusicFlow Downloader 4.1 - Variáveis de Ambiente
# ============================================

# --- Frontend (Next.js / GitHub Pages) ---
# URL pública HTTPS do backend em produção (definida no build via GitHub Actions Variables/Secrets)
NEXT_PUBLIC_API_URL=
# Em modo BFF local (next dev/start):
WORKER_BASE_URL=http://localhost:4000
FRONTEND_BASE_URL=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="MusicFlow Downloader"
APP_VERSION=4.1.0

# --- Segredos Exclusivos do Backend (NUNCA usar NEXT_PUBLIC_) ---
# Segredo para assinatura HMAC das sessões de clientes e tickets temporários de download
SESSION_SECRET=change-this-to-a-strong-64-char-random-secret
# Chave de criptografia AES-256-GCM dos tokens Spotify salvos em disco
ENCRYPTION_KEY=change-this-to-a-separate-64-char-random-key
# Segredo server-to-server entre BFF Next.js e Worker (nunca enviado ao navegador)
WORKER_API_SECRET=change-this-to-a-strong-random-secret-in-production
# Segredo para proteger /diagnostics em produção (obrigatório em NODE_ENV=production)
ADMIN_DIAGNOSTICS_SECRET=change-this-to-an-admin-secret

# --- Worker (Node.js + FFmpeg + yt-dlp) ---
PORT=4000
NODE_ENV=development
# Em produção, defina a origem exata do frontend (ex: https://feliperetmal.github.io)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Limites de processamento e proteção contra abuso
WORKER_CONCURRENCY=2
FFMPEG_THREADS=2
FFMPEG_TIMEOUT_MS=300000
MAX_UPLOAD_MB=200
MAX_DURATION_SECONDS=1800
TEMP_FILE_TTL_MINUTES=180
MAX_JOB_RETRIES=2
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# Caminhos opcionais (se omitidos, usa binários empacotados ou do sistema)
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
TEMP_DIR=./tmp/musicflow

# --- Spotify Web API & OAuth 2.0 (PKCE) ---
SPOTIFY_CLIENT_ID=c18da041f1b648ed9fdec51b82717160
SPOTIFY_CLIENT_SECRET=
# Local: http://127.0.0.1:8888/callback | Produção: https://<SEU-BACKEND>/auth/spotify/callback
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
SPOTIFY_SCOPES=playlist-read-private playlist-read-collaborative

# --- YouTube Data API v3 (Opcional, para enriquecimento de metadados) ---
YOUTUBE_API_KEY=

# Segurança SSRF (mantenha false em produção)
ALLOW_PRIVATE_NETWORK_FETCH=false
