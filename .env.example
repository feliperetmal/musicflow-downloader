# ============================================
# MusicFlow Downloader v3.0 - Variáveis de Ambiente
# ============================================

# --- Frontend (Next.js / Vercel) ---
WORKER_BASE_URL=http://localhost:4000
FRONTEND_BASE_URL=http://localhost:3000
# Segredo compartilhado entre o BFF do Next.js e o Worker (NUNCA usar NEXT_PUBLIC_)
WORKER_API_SECRET=change-this-to-a-strong-random-secret-in-production
# Segredo opcional para proteger o painel /admin/diagnostics em produção
ADMIN_DIAGNOSTICS_SECRET=
NEXT_PUBLIC_APP_NAME="MusicFlow Downloader"
APP_VERSION=3.0.0

# --- Worker (Node.js + FFmpeg) ---
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Limites de processamento e proteção contra abuso
WORKER_CONCURRENCY=2
FFMPEG_THREADS=2
FFMPEG_TIMEOUT_MS=300000
MAX_UPLOAD_MB=200
MAX_DURATION_SECONDS=1800
JOB_TTL_MINUTES=60
MAX_JOB_RETRIES=2
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# Caminhos opcionais (se omitidos, usa ffmpeg-static / ffprobe-static empacotados)
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
TEMP_DIR=./tmp/musicflow

# --- Spotify Web API & OAuth 2.0 (PKCE) ---
SPOTIFY_CLIENT_ID=c18da041f1b648ed9fdec51b82717160
SPOTIFY_CLIENT_SECRET=SUBSTITUIR_POR_NOVO_SEGREDO
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
SPOTIFY_SCOPES=playlist-read-private playlist-read-collaborative

# --- YouTube Data API v3 (Opcional, para enriquecimento de metadados) ---
YOUTUBE_API_KEY=

# Segurança SSRF (mantenha false em produção)
ALLOW_PRIVATE_NETWORK_FETCH=false
